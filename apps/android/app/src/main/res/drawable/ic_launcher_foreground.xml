<?xml version="1.0" encoding="utf-8"?>
<!--
    The BandEar mark for the launcher icon's foreground layer, on the 108 dp adaptive-icon canvas.
    The paths are docs/brand/bandear-mark.svg's, in its 1024 viewport (1024 units = 108 dp). The
    group scales the mark by 0.82 around its centre (517, 516) and moves that centre to the canvas
    centre, so its farthest point (the stem's top corner, stroke included) sits about 303 units from
    the centre: inside the 66 dp safe circle (313 units), so no launcher mask cuts it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <group
        android:pivotX="517"
        android:pivotY="516"
        android:scaleX="0.82"
        android:scaleY="0.82"
        android:translateX="-5"
        android:translateY="-4">
        <!-- Outer B: top bar, stem, bottom bar and the lower bowl. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/bandear_mark"
            android:strokeWidth="46"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M520,224 H344 A48,48 0 0,0 296,272 V738 A70,70 0 0,0 366,808 H556 A186,186 0 0,0 692,528" />
        <!-- The notch where the upper arc meets the lower bowl. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/bandear_mark"
            android:strokeWidth="46"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M736,446 Q720,486 678,514" />
        <!-- The top of the lower bowl, rising from the stem. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/bandear_mark"
            android:strokeWidth="46"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M314,522 C354,482 404,470 476,470 H606" />
        <!-- The inner loop. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/bandear_mark"
            android:strokeWidth="46"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M402,708 H562 A71,71 0 0,0 562,566 H474 A72,72 0 0,0 402,638" />
        <!-- The signal arcs. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/bandear_mark"
            android:strokeWidth="46"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M586,302 A92,92 0 0,1 662,386" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="@color/bandear_mark"
            android:strokeWidth="46"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M584,224 A162,162 0 0,1 738,386" />
    </group>
</vector>
